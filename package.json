  "license": "MPL-2.0",
  "dependencies": {
    "@playwright/browser-chromium": "1.56.1",
    "@playwright/test": "1.56.1",
    "artillery": "^2.0.26",
    "debug": "4.4.3",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "tap": "21.1.3",
    "zx": "8.8.5"
  }
}
