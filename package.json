{
  "name": "artillery-engine-playwright",
  "version": "1.18.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tap test/*.test.js --timeout 300",
    "test:aws": "tap test/*.aws.js --timeout 420",
    "test:aws:ci": "tap --timeout=420",
    "start": "WORKER_IMAGE_URL=public.ecr.aws/artilleryio/artillery-worker:c232b6a7e89f54c2f8fc3c799f4252f5293df3dc-x86_64 artillery run-fargate --region eu-central-1 --count 20 --launch-config '{\"cpu\": 4096, \"memory\": 8192}' src/artillery/artilleryplaywright.yml",
    "test-08": "WORKER_IMAGE_URL=public.ecr.aws/artilleryio/artillery-worker:c232b6a7e89f54c2f8fc3c799f4252f5293df3dc-x86_64 artillery run-fargate --region eu-central-1 --count 20 --launch-config '{\"cpu\": 4096, \"memory\": 8192}' src/artillery/08-artilleryplaywright_ramp.yml",
    "local": "artillery run src/artillery/artilleryplaywright_local_ramp.yml"
  },
  "tap": {
    "disable-coverage": true,
    "allow-empty-coverage": true,
    "color": true,
    "test-env": [
      "ARTILLERY_TELEMETRY_DEFAULTS={\"source\":\"test-suite\"}"
    ]
  },
  "keywords": [],
